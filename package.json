{
  "name": "yfiten-phone",
  "version": "1.0.0",
  "description": "Yfiten mobile ticket capture app",
  "main": "index.js",
  "scripts": {
    "build": "npx esbuild src/app.js --bundle --outfile=www/js/app.js --format=esm --target=es2020 --minify",
    "dev": "npx esbuild src/app.js --bundle --outfile=www/js/app.js --format=esm --target=es2020 --watch",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios"
  },
  "keywords": [],
  "author": "Yfiten",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.3",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "qrcode": "^1.5.4"
  }
}
